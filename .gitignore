# Local pointer to the Quetzal installation (see README.md)
.quetzal_path

# Working material that must not be published: photographs of installed piping,
# client drawings, site models. See AGENTS.md.
private/

# Raw site scans and their parse caches (scan-to-model skill). Scans of real
# sites are private; keep them out even if copied in by mistake.
*.dae
*.e57
*.las
*.laz
*.npz

# Site photos and the scan texture for the mesh example: too large to commit,
# and not read by make_mesh_example.py. Kept local only.
examples/mesh_example/*.png
examples/mesh_example/*.jpg

__pycache__/
*.py[cod]

# FreeCAD backups and lock files
*.FCStd1
*.FCBak
.FCStd.lock

.vs/
*.vsidx
.idea/
.DS_Store
